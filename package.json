{
  "name": "company-profile-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "test": "bun run --cwd apps/web test && bun run --cwd packages/figma-to-site test && bun run --cwd packages/site-to-cms test && bun run --cwd packages/deploy-to-vercel test",
    "validate:manifest": "bun run --cwd apps/web validate:manifest",
    "verify:design": "bun run --cwd apps/web verify:design",
    "capture:figma": "bun run --cwd apps/web capture:figma",
    "e2e": "bun run --cwd apps/web e2e",
    "e2e:report": "bun run --cwd apps/web e2e:report",
    "evidence": "bun scripts/e2e-evidence.mjs",
    "parity-report": "bun scripts/parity-report.mjs"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "sharp": "^0.35.3"
  }
}
