# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
.next-e2e-throwaway/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never committed, at any depth
.env*
# ...except the template, which carries names and never values. `.env*` above is
# unanchored so it matches apps/web/.env too; without this negation it would also
# swallow the one file developers need to see.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project
.tokensave
.superpowers/

# playwright e2e
e2e-results/
test-results/
design/verify/
design/captures/

# claude plugin eval run output (scores, HTML report). Leading ** because a
# pattern with a slash in it is anchored to this file, and the suite lives in
# packages/figma-to-site — the unanchored rule matched nothing for six commits.
**/evals/results/

# bun run evidence output (report, PR section, run log)
e2e-evidence/

# bun run parity-report output (three-way report, html and json)
parity-report/

# Payload CMS (Phase 2): local dev database, its generated types, and the
# media collection's local upload storage (seeded from public/img at runtime)
apps/web/payload.db
apps/web/payload-types.ts
apps/web/media/
